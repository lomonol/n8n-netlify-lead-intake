    {
      "id": "5cda6ca3-d4ab-4412-a256-2d8cca4dae23",
      "name": "Quote Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        192
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "netlify-lead-intake",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Netlify Intake Token"
        }
      }
    },
    {
      "id": "3914a9b3-8a9d-4cc4-9f84-1ed39b5457aa",
      "name": "Check Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Second check after the serverless function: never trust the caller.\nconst b = $json.body || {};\nconst errors = [];\nconst s = (v, max) => String(v ?? '').trim().slice(0, max);\nconst lead = {\n  dedupe_key: s(b.dedupe_key, 160),\n  name: s(b.name, 80),\n  phone: s(b.phone, 20),\n  email: b.email ? s(b.email, 120).toLowerCase() : '',\n  zip: s(b.zip, 10),\n  service: s(b.service, 30),\n  preferred_time: s(b.preferred_time, 20) || 'any',\n  message: b.message ? s(b.message, 1000) : '',\n  source: s(b.source, 40) || 'unknown',\n  submitted_at: s(b.submitted_at, 40) || new Date().toISOString(),\n};\nif (lead.name.length < 2) errors.push('name');\nif (!/^\\+1[2-9]\\d{9}$/.test(lead.phone)) errors.push('phone');\nif (!/^\\d{5}(-\\d{4})?$/.test(lead.zip)) errors.push('zip');\nif (!['ac-repair','heating-repair','maintenance','new-install','other'].includes(lead.service)) errors.push('service');\nif (lead.dedupe_key !== lead.phone + '|' + (lead.email || '-')) errors.push('dedupe_key');\n// Labelled test data stays separable from real leads.\nlead.is_test = /^test lead/i.test(lead.name) || /@example\\.(com|org|net)$/.test(lead.email);\nreturn { json: { valid: errors.length === 0, errors, lead } };"
      }
    },
    {
      "id": "7fcfd9ca-dd66-48c8-bae4-1a35aec1b2d7",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
